# =============================================================================
# LLMetry Backend — Environment Variables
# Copy this file to .env and fill in real values before running locally or
# via Docker Compose.  .env is git-ignored and must never be committed.
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# When running via docker-compose, DB_HOST is overridden to "postgres"
# (the service name) automatically — you only need to change it for local dev.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=llmetry
# Set to "true" when connecting to a managed DB that requires SSL (e.g. Render, Supabase)
DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
TOKEN_SECRET=replace-with-a-different-strong-random-secret

# ─── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# Must be a 64-character hex string (= 32 raw bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars-generated-by-openssl-rand-hex-32

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Optional: host port for docker-compose ───────────────────────────────────
# Change this if port 5000 is already in use on your machine.
# HOST_PORT=5000
